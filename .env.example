# ==============================================================================
# Tiffin Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these in your Vercel Project Settings:
# Settings -> Environment Variables

# Web Push VAPID Keys (Optional - only needed if using Vercel Serverless Web Push)
# Generate a new pair by running: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tiffin-tracker.app

# Optional: Upstash Redis / Vercel KV REST API (for persistent push subscriptions)
KV_REST_API_URL=
KV_REST_API_TOKEN=
