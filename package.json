{
  "name": "tiffin-tracker",
  "version": "5.4.0",
  "description": "Tiffin Tracker PWA with native real-time cloud sync and Web Push notifications",
  "main": "www/index.html",
  "scripts": {
    "start": "serve -s www",
    "test": "node -c www/app.js && node -c www/sw.js && node -c www/updater.js",
    "build:apk": "node scripts/build-release.js",
    "build:patch": "node scripts/build-release.js patch",
    "build:minor": "node scripts/build-release.js minor",
    "build:major": "node scripts/build-release.js major",
    "build:icons": "node scripts/generate-icons.js",
    "sync:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "test:apk": "powershell -ExecutionPolicy Bypass -File scripts/test-apk.ps1",
    "run:emulator": "cmd /c scripts\\run-on-emulator.bat"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^13.2.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
