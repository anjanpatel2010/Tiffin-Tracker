{
  "name": "tiffin-tracker",
  "version": "5.7.9",
  "description": "Tiffin Tracker Android Native App with Firebase Cloud Messaging and real-time cloud sync",
  "main": "www/index.html",
  "scripts": {
    "start": "serve -s www",
    "test": "node -c www/app.js && node -c www/updater.js && node -c www/firebase-sync.js && node -c www/fcm-dispatcher.js",
    "build:apk": "node scripts/build-release.js",
    "build:patch": "node scripts/build-release.js patch",
    "build:minor": "node scripts/build-release.js minor",
    "build:major": "node scripts/build-release.js major",
    "build:icons": "node scripts/generate-icons.js",
    "sync:android": "npx cap sync android",
    "fcm:server": "node scripts/send-fcm-server.js",
    "fcm:test": "node scripts/send-fcm-server.js --test",
    "open:android": "npx cap open android",
    "test:apk": "powershell -ExecutionPolicy Bypass -File scripts/test-apk.ps1",
    "run:emulator": "cmd /c scripts\\run-on-emulator.bat"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
