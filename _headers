# Netlify Cache Control Headers

# Service worker must never be cached
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Expires: 0

# Manifest
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# HTML Shell and documents must always revalidate immediately
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Expires: 0

# Scripts and Styles - always revalidate immediately
/*.css
  Cache-Control: no-cache, no-store, must-revalidate
  Expires: 0

/*.js
  Cache-Control: no-cache, no-store, must-revalidate
  Expires: 0
